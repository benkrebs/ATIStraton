# Beispielkonfiguration für Entwicklungs- und Diagnoseskripte.
# Kopieren nach .env — diese Datei ist per .gitignore ausgeschlossen.
#
# Die Integration selbst braucht das NICHT: Sie wird über den Config Flow in
# Home Assistant eingerichtet, und die Zugangsdaten liegen dort im
# verschlüsselten Credential-Store.

# Adresse der Leuchte im eigenen Netz.
ATI_HOST=192.168.1.42

# Benutzername der Geräte-Weboberfläche.
ATI_USER=admin

# Passwort NICHT hier eintragen.
#
# Unter macOS gehört es in den Schlüsselbund:
#
#     security add-generic-password -a "$ATI_USER" -s ati-straton -w
#
# und wird bei Bedarf so gelesen, ohne je in einer Datei oder der
# Shell-History zu landen:
#
#     ATI_PW="$(security find-generic-password -s ati-straton -w)"
#
# Unter Linux entsprechend mit secret-tool, pass oder einem anderen
# Schlüsselbund.
